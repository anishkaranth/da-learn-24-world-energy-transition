{
 "snapshot": "headline KPIs + run config",
 "project": "da-learn-24-world-energy-transition",
 "source_mode": "full",
 "engine": "duckdb 1.5.6",
 "config": {
  "sql_dialect": "Spark SQL style (+ DuckDB shims in sql/00), run on DuckDB; Databricks skipped (workspace quota)",
  "grain": "fact_energy_year = one entity x year with any energy value; fact_energy_mix = entity x year x source (9 sources)",
  "entity_rule": "3-letter ISO code = country; USSR, Yugoslavia, Czechoslovakia, East/West Germany, Serbia and Montenegro = historical; Kosovo (no ISO) = country OWID_KOS; empty iso_code / OWID_ prefix = aggregate (World, continents, income groups, EI / EIA / Ember / Shift regions). Country rankings use countries only; World/continent figures use OWID's aggregate rows",
  "latest_year_rule": "per metric, the last year with >= 90% of peak country coverage: energy mix 2024 (Energy Institute, ~79 countries), electricity + carbon intensity 2024, GDP 2022, all-country primary energy 2023; 2025 is part-year (provisional)",
  "thresholds": "transitions >= 10 TWh generated; carbon-intensity ranking >= 50 TWh; coal phase-out = coal >= 20% of power in 2000 and >= 5 TWh now; energy vs GDP and decoupling = countries >= 1 million people",
  "outlier_rules": "energy per capita > 3x the year's country p95 flagged; grid carbon intensity > 900 g/kWh and above a fuel-mix ceiling (coal 1,100 / oil 900 / gas 700 / other 50) flagged and left out of the intensity ranking",
  "sample_rule": "data/raw: every 4th ISO country + 9 large systems + historical states + 16 aggregates, all years (CO2 from 1900); scripts/make_sample.py"
 },
